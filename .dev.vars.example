# 本地开发用的环境变量示例
# 用法：复制本文件为 .dev.vars，按需要修改（.dev.vars 已被 .gitignore 忽略）

# 发送消息所需密钥。调用 /send 或 /api/send 时必须提供。
# 建议设置得长一些，例如用密码生成器生成 32 位随机字符串。
SEND_TOKEN=dev-send-token-please-change-me

# 查看 / 清空消息所需密钥。留空 = 查看页面完全公开。
# 若在同一网络中共享，建议也设置一个独立密钥。
READ_TOKEN=

# 企业微信群机器人 Webhook 完整 URL（可选）。
# 配置后每条新通知会主动推到企业微信群；留空则只有网页收件箱。
# 获取方式：企业微信 App → 群聊 → 右上角「…」→ 群机器人 → 添加 → 复制 Webhook 地址。
# 线上部署时请改用 Dashboard → Settings → Variables → Secrets 设置同名变量，不要写进代码。
WECOM_WEBHOOK=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile 人机验证（可选，默认关闭）
# ---------------------------------------------------------------------------
# 登录接口 /api/login 增加一层人机验证，防暴力破解与脚本自动化。
# 官方文档：https://developers.cloudflare.com/turnstile/
#
# 获取方式：Cloudflare Dashboard → Turnstile → Add widget
#   - 名称随意，例如 cloudflare-notify
#   - Widget Domain 填你的部署域名（如 cloudflare-notify.com）
#   - 拿到 Site Key（0x... 开头）与 Secret Key
#
# 两个变量必须**同时设置**才会启用；只配一个会被视为"未启用"并在
# /api/status 标为 misconfigured —— 这样不会出现"配错了把人锁在门外"。
# 留空（都不填）= 完全不启用，不加载任何外部资源、不放宽 CSP。
#
# SITE KEY 是公开的，可以放普通变量；
# SECRET KEY 只能放 Secrets，绝不能写进代码或提交到 GitHub。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 中国大陆部署可选：改用中国区源站（组件与 Siteverify 接口同步切换）。
# 留空 = 全球站 https://challenges.cloudflare.com
# TURNSTILE_API_ORIGIN=https://challenges.cloudflare-cn.com

# 允许的域名白名单（可选，逗号分隔，不写 www/协议/端口）。
# 官方建议服务端同时校验 action 与 hostname，防止别处的 token 被搬来复用。
#   - 留空 = 退化为「hostname 必须等于当前访问的域名」，同样能防跨站复用，
#            且不会因为漏配而把用户锁在门外。
#   - 填了 = 严格白名单，只有列表内的域名能通过校验。
# 注意：生产环境不要填 localhost / 127.0.0.1（官方明确提醒）。
# TURNSTILE_HOSTNAMES=cloudflare-notify.com

# ---------------------------------------------------------------------------
# v2.0 可选配置
# ---------------------------------------------------------------------------
# 消息自动过期天数（1~365，默认 90）。历史消息到期自动删除，
# 防止免费版 KV 的 1GB 存储上限被长期累积的消息占满。
MESSAGE_TTL_DAYS=90

# 发送限流（默认值已足够个人/小团队使用，可按业务调整）
SEND_RATE_PER_MIN=60
SEND_RATE_PER_DAY=500
KEY_RATE_PER_MIN=120
KEY_RATE_PER_DAY=1000

# RouterHook 传感器聚合窗口（30 / 60 / 120 秒，默认 60）
# ROUTERHOOK_WINDOW_SECONDS=60

# 入站 HMAC 签名密钥（可选，敏感信息）。
# 设置后所有写请求必须带 X-Cfn-Signature: sha256=<HMAC-SHA256(该密钥, 原始请求体)>。
# 线上请只放 Dashboard → Secrets，不要写进 Git。
# INBOUND_SIGNING_SECRET=
